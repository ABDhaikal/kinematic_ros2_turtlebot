<?xml version="1.0"?>
<!-- Flat floor with grid lines every 1 m (red = X axis, green = Y axis)
     to visually verify distances computed by forward kinematics. -->
<sdf version="1.6">
  <world name="empty_grid">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <model name="grid_markers">
      <static>true</static>
      <link name="link">
        <visual name="line_x_1">
          <pose>-3 0 0.001 0 0 0</pose>
          <geometry><box><size>0.01 6 0.001</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
        <visual name="line_y_2">
          <pose>0 -3 0.001 0 0 0</pose>
          <geometry><box><size>6 0.01 0.001</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
        <visual name="line_x_3">
          <pose>-2 0 0.001 0 0 0</pose>
          <geometry><box><size>0.01 6 0.001</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
        <visual name="line_y_4">
          <pose>0 -2 0.001 0 0 0</pose>
          <geometry><box><size>6 0.01 0.001</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
        <visual name="line_x_5">
          <pose>-1 0 0.001 0 0 0</pose>
          <geometry><box><size>0.01 6 0.001</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
        <visual name="line_y_6">
          <pose>0 -1 0.001 0 0 0</pose>
          <geometry><box><size>6 0.01 0.001</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
        <visual name="line_x_7">
          <pose>0 0 0.001 0 0 0</pose>
          <geometry><box><size>0.01 6 0.001</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material>
        </visual>
        <visual name="line_y_8">
          <pose>0 0 0.001 0 0 0</pose>
          <geometry><box><size>6 0.01 0.001</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material>
        </visual>
        <visual name="line_x_9">
          <pose>1 0 0.001 0 0 0</pose>
          <geometry><box><size>0.01 6 0.001</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
        <visual name="line_y_10">
          <pose>0 1 0.001 0 0 0</pose>
          <geometry><box><size>6 0.01 0.001</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
        <visual name="line_x_11">
          <pose>2 0 0.001 0 0 0</pose>
          <geometry><box><size>0.01 6 0.001</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
        <visual name="line_y_12">
          <pose>0 2 0.001 0 0 0</pose>
          <geometry><box><size>6 0.01 0.001</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
        <visual name="line_x_13">
          <pose>3 0 0.001 0 0 0</pose>
          <geometry><box><size>0.01 6 0.001</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
        <visual name="line_y_14">
          <pose>0 3 0.001 0 0 0</pose>
          <geometry><box><size>6 0.01 0.001</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
      </link>
    </model>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-1.5 -2.5 2.5 0 0.6 1.0</pose>
      </camera>
    </gui>
  </world>
</sdf>
